{
  "name": "celld-react-kv-counter",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "COUNTER_KV",
      "id": "react-counter-data"
    }
  ]
}
