# Reference only: register each key as a Secure Note in the exact folder
# env/oci/celld-test.illuwa.click
# Put the value on the first line of Notes. Do not create a runtime .env file.
APP_DOMAIN=celld-test.illuwa.click

# R2 node local working state; do not reuse the previous celld dev directory.
CELLD_STATE_DIR=./data/celld-r2

# Create a dedicated private R2 bucket. Choose an APAC location hint at creation.
# The hint is best-effort; AWS_REGION=auto does not select a physical region.
CELLD_BUCKET=s3://your-celld-oci-bucket
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
AWS_REGION=auto
AWS_ACCESS_KEY_ID=REPLACE_ME
AWS_SECRET_ACCESS_KEY=REPLACE_ME
